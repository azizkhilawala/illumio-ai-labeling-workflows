# Database connection string
# For Prisma Postgres: prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY
# For local Docker: postgresql://postgres:postgres@localhost:5432/ai_labeling
# For Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# For Neon: postgresql://[USER]:[PASSWORD]@[HOST]/[DATABASE]?sslmode=require

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_labeling"
